{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contacthub.dev/schemas/v1/methods/registry.json",
  "title": "Method registry",
  "description": "Every method with its direction, its schema file and the capability that gates it (or 'required'). Mirrored by ch_protocol::METHODS; the conformance suite and the host read this. Also lists the events (section 10) and the reserved cancel notification.",
  "type": "object",
  "required": ["api_version", "default_timeout_seconds", "methods", "events"],
  "$defs": {
    "GatedParam": {
      "type": "object",
      "required": ["param", "capability"],
      "properties": {
        "param": {
          "description": "Dotted path into params; a '[]' segment means every element of that array (reactions[].custom_emoji_id).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\[\\])?(\\.[a-z][a-z0-9_]*(\\[\\])?)*$"
        },
        "capability": { "$ref": "../capabilities.json#/$defs/CapabilityKey" },
        "equals": {
          "description": "When present, the parameter only needs the capability when its value equals this (kind = \"voice\", revoke = false). Otherwise any present non-null value needs it.",
          "type": ["string", "boolean"]
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "api_version": { "const": "1.1.0" },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "direction", "schema", "capability"],
        "properties": {
          "name": { "$ref": "../jsonrpc.json#/$defs/MethodName" },
          "direction": { "type": "string", "enum": ["core_to_plugin", "plugin_to_core"] },
          "schema": { "type": "string" },
          "capability": {
            "description": "A capability key, or 'required'.",
            "oneOf": [ { "const": "required" }, { "$ref": "../capabilities.json#/$defs/CapabilityKey" } ]
          },
          "timeout_seconds": { "description": "Request timeout; absent = the registry's default_timeout_seconds.", "type": "integer", "minimum": 1 },
          "progress": { "description": "Emits transfer.progress and resets its timeout on each.", "type": "boolean" },
          "gated_params": {
            "description": "Parameters of this method that need a capability beyond the method's own (spec 14.2). The receiver answers NOT_SUPPORTED (data.capability = the key) when such a parameter is present (not absent, not null) and the capability is not declared. Both SDKs and the core enforce from this table.",
            "type": "array",
            "items": { "$ref": "#/$defs/GatedParam" }
          }
        }
      }
    },
    "default_timeout_seconds": {
      "description": "Timeout for every request without timeout_seconds, in both directions: core -> plugin rows that omit it, plugin -> core requests (secrets.*) and events sent as requests (spec 12).",
      "type": "integer",
      "minimum": 1
    },
    "events": { "type": "array", "items": { "$ref": "../events.json#/$defs/EventName" } },
    "cancel": { "const": "$/cancelRequest" }
  },
  "api_version": "1.1.0",
  "default_timeout_seconds": 60,
  "cancel": "$/cancelRequest",
  "events": [
    "status", "conversations.upsert", "conversations.synced", "messages.upsert", "messages.deleted",
    "message.edited", "reaction.changed", "contacts.upsert", "folders.synced", "topics.upsert",
    "read.outbox", "read.inbox", "presence", "draft.changed", "avatar.ready", "media.ready",
    "transfer.progress", "auth.step"
  ],
  "methods": [
    { "name": "initialize", "direction": "core_to_plugin", "schema": "lifecycle.json", "capability": "required", "timeout_seconds": 30 },
    { "name": "shutdown", "direction": "core_to_plugin", "schema": "lifecycle.json", "capability": "required", "timeout_seconds": 10 },
    { "name": "ping", "direction": "core_to_plugin", "schema": "lifecycle.json", "capability": "required", "timeout_seconds": 10 },
    { "name": "account.start", "direction": "core_to_plugin", "schema": "lifecycle.json", "capability": "required", "timeout_seconds": 30 },
    { "name": "account.stop", "direction": "core_to_plugin", "schema": "lifecycle.json", "capability": "required", "timeout_seconds": 30 },

    { "name": "auth.begin", "direction": "core_to_plugin", "schema": "auth.json", "capability": "auth.interactive" },
    { "name": "auth.submit", "direction": "core_to_plugin", "schema": "auth.json", "capability": "auth.interactive" },
    { "name": "auth.cancel", "direction": "core_to_plugin", "schema": "auth.json", "capability": "auth.interactive" },

    { "name": "messages.fetch_recent", "direction": "core_to_plugin", "schema": "messages.json", "capability": "required", "timeout_seconds": 120 },
    { "name": "messages.get", "direction": "core_to_plugin", "schema": "messages.json", "capability": "messages.get" },
    { "name": "messages.send", "direction": "core_to_plugin", "schema": "messages.json", "capability": "required",
      "gated_params": [
        {"param": "entities", "capability": "send.entities"},
        {"param": "reply_to.quote_text", "capability": "quote_reply"},
        {"param": "reply_to.quote_offset", "capability": "quote_reply"},
        {"param": "comment_to", "capability": "comments.send"},
        {"param": "silent", "capability": "send.silent"},
        {"param": "schedule_at", "capability": "send.schedule"},
        {"param": "no_webpage", "capability": "send.no_webpage"},
        {"param": "effect_id", "capability": "send.effects"}
      ] },
    { "name": "messages.send_file", "direction": "core_to_plugin", "schema": "messages.json", "capability": "send.file", "timeout_seconds": 600, "progress": true,
      "gated_params": [
        {"param": "entities", "capability": "send.entities"},
        {"param": "reply_to.quote_text", "capability": "quote_reply"},
        {"param": "reply_to.quote_offset", "capability": "quote_reply"},
        {"param": "as_file", "capability": "send.as_file"},
        {"param": "spoiler", "capability": "send.spoiler"},
        {"param": "kind", "capability": "send.voice", "equals": "voice"},
        {"param": "kind", "capability": "send.video_note", "equals": "video_note"},
        {"param": "silent", "capability": "send.silent"},
        {"param": "schedule_at", "capability": "send.schedule"},
        {"param": "ttl_seconds", "capability": "send.ttl"}
      ] },
    { "name": "messages.send_album", "direction": "core_to_plugin", "schema": "messages.json", "capability": "send.album", "timeout_seconds": 600, "progress": true,
      "gated_params": [
        {"param": "items[].entities", "capability": "send.entities"},
        {"param": "items[].spoiler", "capability": "send.spoiler"},
        {"param": "items[].as_file", "capability": "send.as_file"},
        {"param": "entities", "capability": "send.entities"},
        {"param": "reply_to.quote_text", "capability": "quote_reply"},
        {"param": "reply_to.quote_offset", "capability": "quote_reply"},
        {"param": "silent", "capability": "send.silent"},
