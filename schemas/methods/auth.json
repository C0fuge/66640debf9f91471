{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contacthub.dev/schemas/v1/methods/auth.json",
  "title": "Interactive auth methods (auth.interactive)",
  "$defs": {
    "auth.begin.params": {
      "type": "object",
      "required": ["account_id", "method"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "method": { "description": "One of the manifest's auth_methods.", "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "auth.begin.result": { "$ref": "../common.json#/$defs/Empty" },
    "auth.submit.params": {
      "type": "object",
      "required": ["account_id", "flow", "step_id", "value"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "flow": { "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "auth.submit.result": { "$ref": "../common.json#/$defs/Empty" },
    "auth.cancel.params": {
      "type": "object",
      "required": ["account_id", "flow"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "flow": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "auth.cancel.result": { "$ref": "../common.json#/$defs/Empty" }
  }
}
