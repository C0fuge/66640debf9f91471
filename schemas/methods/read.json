{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contacthub.dev/schemas/v1/methods/read.json",
  "title": "Read state, typing, mentions and pins",
  "$defs": {
    "read.send_receipt.params": {
      "type": "object",
      "required": ["account_id", "chat_id", "max_message_id"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "chat_id": { "$ref": "../common.json#/$defs/Id" },
        "topic_id": { "anyOf": [ { "$ref": "../common.json#/$defs/Id" }, { "type": "null" } ] },
        "max_message_id": { "$ref": "../common.json#/$defs/Id" }
      },
      "additionalProperties": true
    },
    "read.send_receipt.result": { "$ref": "../common.json#/$defs/Empty" },
    "typing.send.params": {
      "type": "object",
      "required": ["account_id", "chat_id", "action"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "chat_id": { "$ref": "../common.json#/$defs/Id" },
        "topic_id": { "anyOf": [ { "$ref": "../common.json#/$defs/Id" }, { "type": "null" } ] },
        "action": { "$ref": "../dto/presence.json#/$defs/PresenceAction" }
      },
      "additionalProperties": true
    },
    "typing.send.result": { "$ref": "../common.json#/$defs/Empty" },
    "mentions.list_unread.params": { "$ref": "common.json#/$defs/ChatTopicLimitParams" },
    "mentions.list_unread.result": { "$ref": "common.json#/$defs/MessageIdsResult" },
    "mentions.read.params": { "$ref": "common.json#/$defs/ChatTopicParams" },
    "mentions.read.result": { "$ref": "../common.json#/$defs/Empty" },
    "pins.list.params": { "$ref": "common.json#/$defs/ChatTopicPagedParams" },
    "pins.list.result": { "$ref": "common.json#/$defs/PagedMessagesResult" }
  }
}
