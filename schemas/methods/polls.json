{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contacthub.dev/schemas/v1/methods/polls.json",
  "title": "Poll methods",
  "$defs": {
    "polls.create.params": {
      "type": "object",
      "required": ["account_id", "chat_id", "question", "options"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "chat_id": { "$ref": "../common.json#/$defs/Id" },
        "question": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "multiple": { "type": ["boolean", "null"] },
        "quiz": { "type": ["boolean", "null"] },
        "anonymous": { "description": "Default true.", "type": ["boolean", "null"] },
        "correct_option": { "description": "Quiz: index into options.", "type": ["integer", "null"], "minimum": 0 },
        "solution": { "type": ["string", "null"] },
        "solution_entities": { "type": "array", "items": { "$ref": "../dto/message.json#/$defs/Entity" } },
        "close_after_seconds": { "type": ["integer", "null"], "minimum": 0 },
        "reply_to": { "anyOf": [ { "$ref": "common.json#/$defs/ReplyTarget" }, { "type": "null" } ] },
        "topic_id": { "anyOf": [ { "$ref": "../common.json#/$defs/Id" }, { "type": "null" } ] },
        "silent": { "type": ["boolean", "null"] },
        "schedule_at": { "anyOf": [ { "$ref": "../common.json#/$defs/Timestamp" }, { "type": "null" } ] }
      },
      "additionalProperties": true
    },
    "polls.create.result": { "$ref": "common.json#/$defs/MessageResult" },
    "polls.vote.params": {
      "type": "object",
      "required": ["account_id", "chat_id", "message_id", "option_ids"],
      "properties": {
        "account_id": { "$ref": "../common.json#/$defs/AccountId" },
        "chat_id": { "$ref": "../common.json#/$defs/Id" },
        "message_id": { "$ref": "../common.json#/$defs/Id" },
        "option_ids": { "description": "[] retracts.", "$ref": "../common.json#/$defs/IdList" }
      },
      "additionalProperties": true
    },
    "polls.vote.result": { "$ref": "common.json#/$defs/OptionalMessageResult" },
    "polls.close.params": { "$ref": "common.json#/$defs/ChatMessageParams" },
    "polls.close.result": { "$ref": "common.json#/$defs/OptionalMessageResult" }
  }
}
