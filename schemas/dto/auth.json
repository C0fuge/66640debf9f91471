{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contacthub.dev/schemas/v1/dto/auth.json",
  "title": "AuthStep",
  "$defs": {
    "AuthStepKind": {
      "type": "string",
      "enum": ["phone", "code", "password", "qr", "email", "email_code", "text", "info", "done"]
    },
    "AuthStep": {
      "description": "One step of an interactive flow, rendered generically by the core. docs/plugin-api.md section 7.1.",
      "type": "object",
      "required": ["flow", "step_id", "kind"],
      "properties": {
        "flow": { "description": "sign_in, two_factor, or plugin-defined.", "type": "string", "minLength": 1 },
        "step_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/AuthStepKind" },
        "title": { "type": ["string", "null"] },
        "hint": { "type": ["string", "null"] },
        "placeholder": { "type": ["string", "null"] },
        "data": { "description": "qr: the payload to render.", "type": ["string", "null"] },
        "expires_at": { "anyOf": [ { "$ref": "../common.json#/$defs/Timestamp" }, { "type": "null" } ] },
        "can_resend": { "type": "boolean", "default": false },
        "min_length": { "type": ["integer", "null"], "minimum": 0 },
        "max_length": { "type": ["integer", "null"], "minimum": 0 },
        "error": { "description": "Why the previous submission was rejected.", "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
