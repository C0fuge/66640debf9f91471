# Cached official node:22 and rust:1-slim images (Rust 1.99).
FROM docker.io/library/node@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS node
FROM docker.io/library/rust@sha256:2752b332db73fdbb7dc576f06c82ed1f312005784ef913d7e04a28f5f55dc581
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates git pkg-config libdbus-1-dev python3 python3-venv \
       libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
       chromium xvfb xauth \
    && rm -rf /var/lib/apt/lists/* \
    && rustup component add clippy rustfmt \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && node -e 'if (process.versions.node.split(".")[0] !== "22") process.exit(1)' \
    && npm --version \
    && python3 -c 'import sys; assert sys.version_info >= (3, 12)' \
    && rustc --version && cargo fmt --version && cargo clippy --version && uv --version
WORKDIR /work
